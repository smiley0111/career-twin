# DeepSeek API (主力模型, 便宜好用, 国内直连)
# 注册: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选: 用 OpenAI / Claude / Qwen 替换. 它们都兼容 OpenAI 协议.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Embedding (RAG 用, Stage 4) ----------
# 部署 & 推荐: api 模式 (本地 fastembed 在部分 Windows/容器上 onnxruntime DLL 报错).
# 想纯离线本地跑再改回 local (需 pip install fastembed + Visual C++ Runtime).
EMBEDDING_PROVIDER=api

# --- API 模式配置 (EMBEDDING_PROVIDER=api 时生效) ---
# 推荐硅基流动 SiliconFlow: 注册送额度, BGE-M3 免费
# 注册: https://cloud.siliconflow.cn
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- 部署相关 ----------
# 允许跨域的前端来源 (逗号分隔). 部署后填 Vercel 域名.
# 前端走 Next.js rewrite 代理时其实不触发 CORS, 这个是给"直连后端 API"兜底.
# CORS_ORIGINS=https://your-frontend.vercel.app
