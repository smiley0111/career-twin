# DeepSeek API (主力模型, 便宜好用, 国内直连)
# 注册: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选: 用 OpenAI / Claude / Qwen 替换. 它们都兼容 OpenAI 协议.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Embedding (RAG 用, Stage 4) ----------
# 默认 local: 本地 BGE-small-zh, 走 fastembed/ONNX, 需要 Visual C++ Runtime
# 如果本地装不上 (Windows DLL 报错), 切换 api 模式
EMBEDDING_PROVIDER=local

# --- API 模式配置 (EMBEDDING_PROVIDER=api 时生效) ---
# 推荐硅基流动 SiliconFlow: 注册送 14 元额度, BGE-M3 几乎用不完
# 注册: https://cloud.siliconflow.cn
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
